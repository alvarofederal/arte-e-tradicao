// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(LOJISTA)
  ativo         Boolean   @default(true)
  ultimoAcesso  DateTime?

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]
  pedidos    Pedido[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @db.VarChar(500)
  type      TokenType
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

enum Role {
  SUPER_ADMIN
  LOJISTA
  CLIENTE
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ─────────────────────────────────────────
// SANTOS (catálogo — páginas do site + produtos + código da sorte)
// ─────────────────────────────────────────

model Santo {
  id           String   @id @default(cuid())
  numero       Int?     @unique   // nº do catálogo (herda do CardSanto)
  nome         String
  slug         String   @unique   // URL: /santos/[slug]
  dataFesta    String?            // data litúrgica (dia/mês[/ano])
  historia     String?  @db.Text  // história/biografia devocional
  oracao       String?  @db.Text  // oração (opcional)
  imagem       String?  @db.LongText // dataURL — futuro: Cloudinary
  bordaCor     String?            // cor tema (herdada do card)
  ativo        Boolean  @default(true)

  produtos     Produto[]
  codigosSorte CodigoSorte[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("santos")
}

// ─────────────────────────────────────────
// LOJA — Categorias e Produtos
// ─────────────────────────────────────────

model Categoria {
  id       String  @id @default(cuid())
  nome     String
  slug     String  @unique
  ordem    Int     @default(0)
  ativo    Boolean @default(true)

  produtos Produto[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("categorias")
}

model Produto {
  id            String  @id @default(cuid())
  sku           String  @unique
  nome          String
  slug          String  @unique
  descricao     String? @db.Text
  precoCentavos Int     @default(0) // preço em centavos (evita ponto flutuante)
  estoque       Int     @default(0)
  imagem        String? @db.LongText // foto do produto; se vazio, usa a do Santo
  ativo         Boolean @default(true)

  santoId     String?
  santo       Santo?     @relation(fields: [santoId], references: [id])
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([santoId])
  @@index([categoriaId])
  @@map("produtos")
}

// ─────────────────────────────────────────
// PEDIDOS (checkout + PIX manual)
// ─────────────────────────────────────────

model Pedido {
  id             String       @id @default(cuid())
  numero         Int          @unique // nº sequencial amigável (calculado no server)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  status         PedidoStatus @default(AGUARDANDO_PAGAMENTO)
  totalCentavos  Int
  // Snapshot de contato/entrega (não depende de perfil futuro)
  nomeCliente    String
  telefone       String
  cep            String?
  endereco       String?      @db.Text
  observacao     String?      @db.Text
  // Desconto (voucher do Código da Sorte)
  subtotalCentavos Int      @default(0)
  descontoCentavos Int      @default(0)
  voucherId        String?
  voucherCodigo    String?
  // Pagamento (PIX manual — confirmação pelo admin)
  pagoEm         DateTime?
  enviadoEm      DateTime?
  canceladoEm    DateTime?

  itens          ItemPedido[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(cuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String? // sem FK forte: mantém histórico mesmo se o produto sumir
  sku           String
  nome          String  // snapshot do nome no momento da compra
  slug          String  // snapshot do slug (link)
  imagem        String? @db.LongText
  precoCentavos Int     // snapshot do preço unitário
  qtd           Int

  @@index([pedidoId])
  @@map("itens_pedido")
}

enum PedidoStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  ENVIADO
  CANCELADO
}

// ─────────────────────────────────────────
// CÓDIGO DA SORTE (código na embalagem → voucher de desconto)
// ─────────────────────────────────────────

model CodigoSorte {
  id              String    @id @default(cuid())
  codigo          String    @unique // XXXX-XXXX-XXXX-XXXX (sem caracteres ambíguos)
  santoId         String            // Santo da caixa (fica EXCLUÍDO do voucher)
  santo           Santo     @relation(fields: [santoId], references: [id])
  descontoPercent Int               // prêmio pré-atribuído (5..50)
  lote            String            // rótulo do lote de impressão
  liberado        Boolean   @default(false) // só vale após liberado pelo admin
  resgatado       Boolean   @default(false)
  resgatadoPorId  String?           // user que resgatou (sem FK)
  resgatadoEm     DateTime?
  voucherId       String?           // voucher gerado no resgate

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([santoId])
  @@index([lote])
  @@index([resgatadoPorId])
  @@map("codigos_sorte")
}

model Voucher {
  id                String    @id @default(cuid())
  codigo            String    @unique
  userId            String            // dono do voucher (sem FK)
  descontoPercent   Int
  santoExcluidoId   String            // Santo que NÃO recebe o desconto (o da caixa)
  santoExcluidoNome String            // denormalizado para exibição
  origemCodigoId    String?   @unique // código da sorte de origem
  expiraEm          DateTime
  usado             Boolean   @default(false)
  usadoEm           DateTime?
  pedidoId          String?           // pedido onde foi aplicado

  criadoEm     DateTime @default(now())

  @@index([userId])
  @@map("vouchers")
}

// ─────────────────────────────────────────
// CARDS DOS SANTOS (estúdio de cards — spec 007)
// ─────────────────────────────────────────

model CardSanto {
  id          String  @id @default(cuid())
  numero      Int?    @unique      // nº GLOBAL, sequencial e PERMANENTE (nunca reaproveitado)
  nome        String
  subtitulo   String? @db.Text     // legado (padrão antigo)
  dataFesta   String?              // data comemorativa DD/MM (ex.: "15/10")
  descricao   String? @db.Text
  imagem      String? @db.LongText // dataURL (base64) — futuro: URL do Cloudinary
  estilo      Json                 // cores/borda/toggles (ver Design no card-studio)

  criadoPorId String?              // id do usuário que criou (sem FK — desacoplado)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoPorId])
  @@map("cards_santos")
}
