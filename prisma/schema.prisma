// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(LOJISTA)
  ativo         Boolean   @default(true)
  ultimoAcesso  DateTime?

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @db.VarChar(500)
  type      TokenType
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

enum Role {
  SUPER_ADMIN
  LOJISTA
  CLIENTE
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ─────────────────────────────────────────
// SANTOS (catálogo — páginas do site + produtos + código da sorte)
// ─────────────────────────────────────────

model Santo {
  id           String   @id @default(cuid())
  numero       Int?     @unique   // nº do catálogo (herda do CardSanto)
  nome         String
  slug         String   @unique   // URL: /santos/[slug]
  dataFesta    String?            // data litúrgica (dia/mês[/ano])
  historia     String?  @db.Text  // história/biografia devocional
  oracao       String?  @db.Text  // oração (opcional)
  imagem       String?  @db.LongText // dataURL — futuro: Cloudinary
  bordaCor     String?            // cor tema (herdada do card)
  ativo        Boolean  @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("santos")
}

// ─────────────────────────────────────────
// CARDS DOS SANTOS (estúdio de cards — spec 007)
// ─────────────────────────────────────────

model CardSanto {
  id          String  @id @default(cuid())
  numero      Int?    @unique      // nº GLOBAL, sequencial e PERMANENTE (nunca reaproveitado)
  nome        String
  subtitulo   String? @db.Text     // legado (padrão antigo)
  dataFesta   String?              // data comemorativa DD/MM (ex.: "15/10")
  descricao   String? @db.Text
  imagem      String? @db.LongText // dataURL (base64) — futuro: URL do Cloudinary
  estilo      Json                 // cores/borda/toggles (ver Design no card-studio)

  criadoPorId String?              // id do usuário que criou (sem FK — desacoplado)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoPorId])
  @@map("cards_santos")
}
